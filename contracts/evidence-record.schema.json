{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ACPA EvidenceRecord",
  "type":"object",
  "required":["record_type","evidence_id","experiment_id","execution_id","evaluation_id","result","decision","promotion_status"],
  "properties":{
    "record_type":{"const":"evidence"},
    "evidence_id":{"type":"string"},
    "experiment_id":{"type":"string"},
    "execution_id":{"type":"string"},
    "evaluation_id":{"type":"string"},
    "result":{"type":"string"},
    "decision":{"type":"string","enum":["iterate","accept_as_experiment","promote","reject","blocked"]},
    "promotion_status":{"type":"string","enum":["unreviewed","provisional","promoted","rejected"]},
    "source":{"type":"string"}
  },
  "additionalProperties":false
}
