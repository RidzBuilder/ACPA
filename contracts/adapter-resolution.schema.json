{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ACPA AdapterResolution",
  "type":"object",
  "required":["resolution_id","engine_id","adapter_id","status"],
  "properties":{
    "resolution_id":{"type":"string"},
    "engine_id":{"type":"string"},
    "adapter_id":{"type":"string"},
    "status":{"type":"string","enum":["resolved","blocked","needs_review"]},
    "unsupported_capabilities":{"type":"array","items":{"type":"string"}},
    "notes":{"type":"string"}
  },
  "additionalProperties":false
}